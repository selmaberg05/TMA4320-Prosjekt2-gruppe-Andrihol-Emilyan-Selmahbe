import numpy as np
import math
import matplotlib.pyplot as plt

alpha = 0.2
N_x = 20
P = 2 * N_x      # periode P
L = 4 * P        # plass til 4 sagtann
N_p = 40 * N_x
Beta_k = 1000
T_p = 40
cycles = 5
t_steps = 2 * cycles * T_p

n_par = 20      # antall partikler
b = 3       # størrekse partikkel

def build_V1(alpha, N_x):
    limit = int(alpha * N_x)
    n = np.arange(N_x)

    V = np.zeros(N_x, dtype=float)

    left = (n <= limit)
    right = (n > limit)

    V[left]  = n[left] / max(limit, 1)
    V[right] = (N_x - n[right]) / max((N_x - limit), 1)

    return np.concatenate([V, V])

V_one = build_V1(alpha, N_x)
V1 = np.tile(V_one, 4)       # lager nytt array med V_one 4 ganger, gir lengde L 
V2 = np.zeros(L)

x0 = np.linspace(0, L-1, n_par, dtype = int)

def probability(V, x0, Beta_k):
    V_l = V[(x0 - 1) % L]
    V_0 = V[x0]
    V_r = V[(x0 + 1) % L]

    p_plus  = 1 / (1 + np.exp(-Beta_k*(V_l - V_r)) + np.exp(-Beta_k*(V_0 - V_r)))
    p_0 = 1 / (1 + np.exp(-Beta_k*(V_r - V_0)) + np.exp(-Beta_k*(V_l - V_0)))
    p_minus = 1 / (1 + np.exp(-Beta_k*(V_r - V_l)) + np.exp(-Beta_k*(V_0 - V_l)))

    return p_plus, p_0, p_minus


def hardcore_flash(x0, t_steps):
    
    x = x0.copy().astype(int)

    t = np.zeros((t_steps + 1, n_par), dtype = int)
    t[0] = x
    
    for i in range(t_steps):
        
        occupied = set()
        for xi in x:
            for k in range(b):
                occupied.add((xi + k) % L)   # legegr til om rett størrelse
            
        order = np.random.permutation(len(x)) #tilfeldig rekkefølge

        for j in order:
            r = np.random.rand() #normaliser

            if r <= p_minus:
                new_pos = (x[j] - 1) % L
            elif r > (1 -  p_plus):
                new_pos = (x[j] + 1) % L
            else:
                new_pos = x[j]

            if new_pos == (x[j] + 1) % L:       
                new_site = (x[j] + b) % L
                if new_site not in occupied:
                    occupied.remove(x[j])                 
                    occupied.add(new_site)                 
                    x[j] = new_pos

            elif new_pos == (x[j] - 1) % L:    
                new_site = (x[j] - 1) % L
                if new_site not in occupied:
                    occupied.remove((x[j] + b - 1) % L)    
                    occupied.add(new_site)                 
                    x[j] = new_pos
                    
        t[i+1] = x
        
    return t
    
p_plus, p_0, p_minus = (V1, x0, Beta_k)

t = hardcore_flash(x0, t_steps)

for j in range(n_par):
    plt.plot(np.arange(t_steps + 1), t[:, j])
    
plt.title("oppgave 4a")
plt.grid(alpha = 0.2)
plt.xlabel("$T_p$")
plt.ylabel("$J_{avg}$")
plt.show()

